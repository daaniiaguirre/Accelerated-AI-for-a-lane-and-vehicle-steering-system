#include "xil_printf.h"
#include "xparameters.h"
#include "ff.h"
#include "xcnn_predict.h"
#include <stdlib.h>
#include <string.h>

#define IMG_SIZE 64
#define NUM_PIXELS (IMG_SIZE * IMG_SIZE)

// Global buffers
static FATFS fs;
float img_buffer[NUM_PIXELS];

// CNN instance
XCnn_predict cnn;

// Read TXT image file from SD into img_buffer
int load_image(const char* path)
{
    FIL f;
    char line[64];
    int i = 0;

    if (f_open(&f, path, FA_READ) != FR_OK) {
        xil_printf("Failed to open %s\n", path);
        return -1;
    }

    while (i < NUM_PIXELS && f_gets(line, sizeof(line), &f)) {
        img_buffer[i] = atof(line);
        i++;
    }

    f_close(&f);

    return (i == NUM_PIXELS) ? 0 : -1;
}

int main()
{
    xil_printf("Starting...\n");

    // 1) Mount SD
    if (f_mount(&fs, "0:/", 1) != FR_OK) {
        xil_printf("SD mount failed\n");
        return -1;
    }

    // Path to file
    char filepath[] = "0:/FRAMES/000116.TXT";

    // 2) Load file
    if (load_image(filepath) != 0) {
        xil_printf("Image load failed\n");
        return -1;
    }

    // 3) Initialize CNN hardware
    int status = XCnn_predict_Initialize(&cnn, XPAR_XCNN_PREDICT_0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("CNN init failed\n");
        return -1;
    }

    // 4) Set pointer to input buffer
    XCnn_predict_Set_img_in(&cnn, (u64)img_buffer);

    // 5) Start hardware
    XCnn_predict_Start(&cnn);

    // 6) Wait until done
    while (!XCnn_predict_IsDone(&cnn));

    // 7) Read output (u32), convert to float
    u32 raw = XCnn_predict_Get_steering_out(&cnn);
    float prediction = *(float*)&raw;

    xil_printf("Prediction (scaled x1e4): %d\n", (int)(prediction * 10000.0f));

    return 0;
}
